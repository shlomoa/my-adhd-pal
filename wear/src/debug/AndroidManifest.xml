<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug builds only (docs/conventions.md, Debug code): log sink, log view, injected-message receiver.
         Only `adb shell`, which holds DUMP, can send to the receiver. -->
    <application
        android:name=".debug.DebugApplication"
        tools:replace="android:name">

        <activity
            android:name=".debug.DebugLogActivity"
            android:exported="true"
            android:taskAffinity="" />

        <receiver
            android:name=".debug.InjectedMessageReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".debug.DemoActionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".debug.FireReminderReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Hardware spike apps (docs/spikes/README.md): a second launcher entry, a command receiver driven by
             adb broadcasts (protected by DUMP, which only `adb shell` holds) and a listener service that logs Data Layer events. Debug builds only. -->
        <activity
            android:name=".debug.spike.SpikeActivity"
            android:exported="true"
            android:label="Spike"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".debug.spike.SpikeCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".debug.spike.SpikeListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/spike" />
            </intent-filter>
        </service>
    </application>
</manifest>
