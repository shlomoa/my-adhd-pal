<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Heart-rate probe (step 6.4, debug only): the permissions of docs/research/watch.md section 4. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Live heart-rate probe (docs/plans/biometrics.md section 11): a foreground service of type health with an ongoing notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Debug builds only (docs/conventions.md, Debug code): log sink, log view, injected-message receiver.
         Only `adb shell`, which holds DUMP, can send to the receiver. -->
    <application
        android:name=".debug.DebugApplication"
        tools:replace="android:name">

        <activity
            android:name=".debug.DebugLogActivity"
            android:exported="true"
            android:taskAffinity="" />

        <receiver
            android:name=".debug.InjectedMessageReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".debug.DemoActionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Shows the heart-rate permission prompt(s) when `pm grant` cannot grant them: adb shell am start. -->
        <activity
            android:name=".debug.probe.ProbePermissionActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="" />

        <!-- Starts the live heart-rate probe from a visible activity: adb shell am start. -->
        <activity
            android:name=".debug.probe.ProbeMeasureActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="" />

        <service
            android:name=".debug.probe.ProbeMeasureService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <receiver
            android:name=".debug.probe.ProbeAlarmReceiver"
            android:exported="false" />

        <activity
            android:name=".debug.probe.ProbeAlertActivity"
            android:exported="false"
            android:taskAffinity="" />

        <receiver
            android:name=".debug.probe.ProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".debug.probe.ProbeListenerService"
            android:exported="true"
            android:permission="com.google.android.wearable.healthservices.permission.PASSIVE_DATA_BINDING">
            <intent-filter>
                <action android:name="hs.passivemonitoring.PASSIVE_LISTENER_SERVICE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".debug.FireReminderReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Hardware spike apps (docs/spikes/README.md): a second launcher entry, a command receiver driven by
             adb broadcasts (protected by DUMP, which only `adb shell` holds) and a listener service that logs Data Layer events. Debug builds only. -->
        <activity
            android:name=".debug.spike.SpikeActivity"
            android:exported="true"
            android:label="Spike"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".debug.spike.SpikeCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <service
            android:name=".debug.spike.SpikeListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/spike" />
            </intent-filter>
        </service>
    </application>
</manifest>
