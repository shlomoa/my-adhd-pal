#!/usr/bin/env bash
# Simulated adb with HARDWARE-STYLE serials for testing scripts/demo/run-demo.ps1 without devices.
#   phone  R58W20ABCDE          (USB serial)
#   watch  192.168.1.57:41203   (Wi-Fi debugging; listed only after `adb connect 192.168.1.57:41203`)
# State lives in $FAKE_DIR. The apps' DEMO log lines are produced from a timeline: `am broadcast` to the phone publishes a
# schedule whose reminder is due FAKE_SECONDS_PER_MINUTE seconds per requested minute later (default 60; tests use 1).
# Failure injection (FAKE_FAIL, comma separated):
#   unauth      phone listed as 'unauthorized'      nowatch     the watch is never listed
#   deadwatch   every 'shell' call to the watch hangs
#   nopublish   the phone has no publish receiver (the broadcast fails)
#   nopublishlog  the publish broadcast works but the phone never logs 'published schedule'
#   unchanged   the phone logs 'published schedule unchanged'     publishfail  the phone logs 'publish failed reason=...'
#   noapply     the schedule never reaches the watch
#   nofire      the reminder never fires        latefire   the reminder fires 3 s late (the test sets a 1 s tolerance)
#   nonotif     no notification is listed       noack      the ack never reaches the phone history
#   noackdone   the watch logs 'ack not sent' (no transport)
# FAKE_LEAK=1 adds a log line with an e-mail address, the watch ip:port and a token.
set -u
D="${FAKE_DIR:?FAKE_DIR must point at the simulation state folder}"
PHONE=R58W20ABCDE; WATCH=192.168.1.57:41203
PKG=com.shlomoa.myadhdpal
serial=""
if [ "${1:-}" = "-s" ]; then serial="$2"; shift 2; fi
cmd="${1:-}"; shift || true
fails() { case ",${FAKE_FAIL:-}," in *",$1,"*) return 0;; esac; return 1; }
now_ms() { echo $(( $(date +%s) * 1000 + 10#$(date +%N | cut -c1-3) )); }
role_of() { case "$1" in "$PHONE") echo phone;; *) echo watch;; esac; }
event() { echo "$1|$2|$3" >> "$D/events"; }   # epoch-ms | role | text
installed() { [ -e "$D/installed.$1" ]; }

# --- device list ---
case "$cmd" in
  devices)
    echo "List of devices attached"
    if fails unauth; then echo "$PHONE	unauthorized"; else echo "$PHONE	device"; fi
    [ -e "$D/watch.connected" ] && ! fails nowatch && echo "$WATCH	device"
    exit 0;;
  connect) touch "$D/watch.connected"; echo "connected to $WATCH"; exit 0;;
  pair) echo "Successfully paired to $1"; exit 0;;
esac

role="$(role_of "$serial")"
if [ "$role" = watch ] && fails deadwatch && [ "$cmd" = shell ]; then sleep 120; exit 0; fi

case "$cmd" in
  install)
    touch "$D/installed.$role"; echo "Success"; exit 0;;
  logcat)
    for a in "$@"; do
      if [ "$a" = "-c" ]; then
        # drop what was logged so far on this device
        t="$(now_ms)"; awk -F'|' -v r="$role" -v t="$t" '!($2==r && $1<=t)' "$D/events" > "$D/events.tmp" 2>/dev/null; mv "$D/events.tmp" "$D/events" 2>/dev/null; touch "$D/events"; exit 0
      fi
    done
    t="$(now_ms)"; touch "$D/events"
    while IFS='|' read -r ms r text; do
      [ "$r" = "$role" ] || continue
      [ "$ms" -le "$t" ] || continue
      printf '%d.%03d  1234  1234 I DEMO    : %s\n' $((ms / 1000)) $((ms % 1000)) "$text"
    done < "$D/events"
    [ -n "${FAKE_LEAK:-}" ] && printf '%d.000  1234  1234 I DEMO    : signed in as test.user@example.com on %s serial %s token=abc123secret\n' $((t / 1000)) "$WATCH" "$PHONE"
    exit 0;;
  shell) ;;
  *) exit 0;;
esac

sub="${1:-}"; shift || true
case "$sub" in
  getprop)
    case "$1" in
      ro.build.characteristics) [ "$role" = watch ] && echo "nosdcard,watch" || echo "default";;
      sys.boot_completed) echo 1;;
    esac;;
  dumpsys)
    case "$1" in
      battery) echo "  level: 80";;
      notification)
        if [ "$role" = watch ] && ! fails nonotif && grep -q "|watch|reminder fired" "$D/events" 2>/dev/null; then
          echo "  NotificationRecord(0x1 pkg=$PKG user=UserHandle{0} id=1 tag=null)"
        fi;;
    esac;;
  pm)
    if [ "$1" = list ]; then installed "$role" && echo "package:$PKG"; fi
    true;;
  date) date +%s;;
  input) true;;
  am)
    amcmd="${1:-}"; shift || true
    case "$amcmd" in
      start) echo "Starting: Intent { cmp=$2 }";;
      broadcast)
        action=""; comp=""; minutes=2; actionname=""
        while [ $# -gt 0 ]; do
          case "$1" in
            -a) action="$2"; shift 2;;
            -n) comp="$2"; shift 2;;
            --ei) [ "$2" = minutes_ahead ] && minutes="$3"; shift 3;;
            --es) [ "$2" = action ] && actionname="$3"; shift 3;;
            *) shift;;
          esac
        done
        t="$(now_ms)"
        case "$action" in
          "$PKG.debug.PUBLISH_DEMO_SCHEDULE")
            fails nopublish && { echo "Error: Activity class {$comp} does not exist."; exit 0; }
            at=$(( t + minutes * ${FAKE_SECONDS_PER_MINUTE:-60} * 1000 ))
            ver=$(( $(cat "$D/version" 2>/dev/null || echo 0) + 1 )); echo "$ver" > "$D/version"; echo "$at" > "$D/reminderAt"
            if fails unchanged; then event "$t" phone "published schedule unchanged reminderAt=$at"
            elif fails publishfail; then event "$t" phone "publish failed reason=repositories not ready"
            else fails nopublishlog || event "$t" phone "published schedule version=$ver reminderAt=$at"; fi
            fails noapply || event $((t + 300)) watch "schedule applied version=$ver"
            if ! fails nofire && ! fails noapply; then
              late=0; fails latefire && late=3000
              event $((at + 200 + late)) watch "reminder fired id=demo occurrenceAt=$at snoozeCount=0"
            fi
            echo "Broadcast completed: result=0";;
          "$PKG.debug.DEMO_ACTION")
            at="$(cat "$D/reminderAt" 2>/dev/null || echo 0)"
            if fails noackdone; then event "$t" watch "ack not sent action=$actionname reminderId=demo reason=no transport"
            else event "$t" watch "ack sent action=$actionname reminderId=demo occurrenceAt=$at"; fi
            echo "Broadcast completed: result=0";;
          "$PKG.debug.DUMP_HISTORY")
            at="$(cat "$D/reminderAt" 2>/dev/null || echo 0)"
            if grep -q "|watch|ack sent action=DONE" "$D/events" 2>/dev/null && ! fails noack; then
              event "$t" phone "history ack id=00000000-0000-4000-8000-000000000001 action=DONE reminderId=demo occurrenceAt=$at at=$t"
            fi
            event "$t" phone "history end count=1"
            echo "Broadcast completed: result=0";;
          *) echo "Broadcast completed: result=0";;
        esac;;
    esac;;
esac
exit 0
