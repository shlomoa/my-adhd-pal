#!/usr/bin/env bash
# Simulated adb for scripts/probe/test-run-e1.sh: one Galaxy Watch at 192.168.1.16:41613 with the debug probe installed.
# State lives in $FAKE_DIR: calls (every invocation), log (the PROBE logcat), timeout, battery, offline.
# Failure injection (FAKE_FAIL, comma separated):  noavail  the service never reports AVAILABLE
#                                                  unavail  the service reports only UNAVAILABLE
#                                                  noaod    no always-on-display setting key is present
#                                                  nosleep  the sleep key does not turn the screen off
#                                                  nostart  the front screen cannot be started
#                                                  nonotif  the notification is never listed
#                                                  svcgone  the measure service is not listed as running
#                                                  stalled  the report's reading count never grows
# FAKE_AWAY_AFTER=N (+ FAKE_AWAY_CALLS=K): after the Nth report the watch goes away (Wi-Fi off): every adb call fails, and the first K
#   `adb connect` calls fail too; the next one brings it back.
# FAKE_FAIL=portchange (with FAKE_AWAY_AFTER=N): after the Nth report the watch comes back on port 42000: the old address never answers
#   again, `adb mdns services` lists the new port (not with nomdns), `adb connect 192.168.1.16:42000` works, and from then on every
#   command needs ANDROID_SERIAL=192.168.1.16:42000 (or -s with it). `adb devices` lists the connected address.
# FAKE_DROP=1: after `input keyevent KEYCODE_SLEEP` the connection drops (device offline) until `adb connect`.
# FAKE_CHARGING=1: the watch is on its charger. It simulates the commands; it proves nothing about the watch.
set -u
D="${FAKE_DIR:?FAKE_DIR must point at the simulation state folder}"
fails() { case ",${FAKE_FAIL:-}," in *",$1,"*) return 0;; esac; return 1; }
echo "$*" >> "$D/calls"
touch "$D/log"
[ -e "$D/timeout" ] || echo 30000 > "$D/timeout"
[ -e "$D/battery" ] || echo 68 > "$D/battery"
[ -e "$D/readings" ] || echo 0 > "$D/readings"
serial="${ANDROID_SERIAL:-}"
[ "${1:-}" = "-s" ] && { serial="$2"; shift 2; }
cmd="${1:-}"; shift || true
if [ -e "$D/away" ] && fails portchange; then
  case "$cmd" in
    mdns)
      fails nomdns || { echo "List of discovered mdns services"; echo "adb-FAKE-1	_adb-tls-connect._tcp	192.168.1.16:42000"; echo "adb-FAKE-1	_adb-tls-pairing._tcp	192.168.1.16:39999"; }
      exit 0;;
    devices) echo "List of devices attached"; exit 0;;
    connect)
      if [ "${1:-}" = "192.168.1.16:42000" ]; then rm -f "$D/away"; touch "$D/moved"; echo "connected to 192.168.1.16:42000"; exit 0; fi
      echo "failed to connect to $1" >&2; exit 1;;
    *) echo "error: no devices/emulators found" >&2; exit 1;;
  esac
fi
if [ -e "$D/moved" ]; then
  case "$cmd" in
    connect) if [ "${1:-}" = "192.168.1.16:42000" ]; then echo "connected to 192.168.1.16:42000"; exit 0; fi; echo "failed to connect to $1" >&2; exit 1;;
    devices) echo "List of devices attached"; echo "192.168.1.16:42000	device"; exit 0;;
    mdns) echo "List of discovered mdns services"; exit 0;;
    *) [ "$serial" = "192.168.1.16:42000" ] || { echo "$cmd" >> "$D/rejected"; echo "error: device '$serial' not found" >&2; exit 1; };;
  esac
fi
if [ "$cmd" = mdns ]; then echo "List of discovered mdns services"; exit 0; fi
if [ "$cmd" = devices ]; then echo "List of devices attached"; echo "192.168.1.16:41613	device"; exit 0; fi
if [ -e "$D/away" ]; then
  if [ "$cmd" = connect ]; then
    n=$(( $(cat "$D/awayconnects" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$D/awayconnects"
    if [ "$n" -le "${FAKE_AWAY_CALLS:-3}" ]; then echo "failed to connect to 192.168.1.16:41613" >&2; exit 1; fi
    rm -f "$D/away" "$D/awayconnects"
  else
    echo "error: no devices/emulators found" >&2; exit 1
  fi
fi
if [ "$cmd" = connect ]; then rm -f "$D/offline"; echo "connected to 192.168.1.16:41613"; exit 0; fi
if [ -e "$D/offline" ]; then echo "error: device offline" >&2; exit 1; fi
note() { echo "$1" >> "$D/log"; }
case "$cmd" in
  logcat)
    for a in "$@"; do
      case "$a" in
        -G) exit 0;;
        -c) : > "$D/log"; exit 0;;
        -d) cat "$D/log"; exit 0;;
      esac
    done
    exit 0;;
  shell)
    sub="${1:-}"; shift || true
    case "$sub" in
      echo) echo "$@"; exit 0;;
      settings)
        if [ "$1" = get ]; then
          if [ "$3" = screen_off_timeout ]; then cat "$D/timeout"
          elif [ "$2/$3" = secure/doze_always_on ] && ! fails noaod && [ ! -e "$D/set-secure-doze_always_on" ]; then echo 1
          elif [ -e "$D/set-$2-$3" ]; then cat "$D/set-$2-$3"
          else echo null; fi
        elif [ "$3" = screen_off_timeout ]; then echo "$4" > "$D/timeout"
        else echo "$4" > "$D/set-$2-$3"; fi
        exit 0;;
      pm)
        if [ "$1" = revoke ]; then echo "java.lang.SecurityException: Permission $3 is not granted" >&2; exit 255; fi
        exit 0;;
      cmd)
        if [ "$1" = notification ]; then echo "$2 $3" >> "$D/dnd"; fi
        exit 0;;
      input)
        [ "$2" = KEYCODE_SLEEP ] && [ -n "${FAKE_DROP:-}" ] && touch "$D/offline"
        if [ "$2" = KEYCODE_SLEEP ] && ! fails nosleep; then echo OFF > "$D/screen"; fi
        if [ "$2" = KEYCODE_WAKEUP ]; then echo ON > "$D/screen"; fi
        exit 0;;
      dumpsys)
        if [ "$1" = battery ]; then
          n="$(cat "$D/battery")"
          if [ -n "${FAKE_CHARGING:-}" ]; then echo "  AC powered: true"; else echo "  AC powered: false"; fi
          echo "  level: $n"; echo $((n - 1)) > "$D/battery"; exit 0
        fi
        if [ "$1" = power ]; then
          echo "  mWakefulness=Awake"; echo "Display Power: state=$(cat "$D/screen" 2>/dev/null || echo ON)"; exit 0
        fi
        if [ "$1" = activity ] && [ "${2:-}" = activities ]; then
          echo "  mResumedActivity: ActivityRecord{1 u0 com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity t5}"
          exit 0
        fi
        if [ "$1" = activity ]; then
          fails svcgone || echo "  * ServiceRecord{1 u0 com.shlomoa.myadhdpal/.wear.debug.probe.ProbeMeasureService}"
          exit 0
        fi
        if [ "$1" = package ]; then
          echo "      android.permission.health.READ_HEART_RATE: granted=true"
          echo "      android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND: granted=false"
          exit 0
        fi
        if [ "$1" = notification ]; then
          fails nonotif || echo "      android.title=Probe: measuring heart rate"
          k=$(( $(cat "$D/notifs" 2>/dev/null || echo 0) + 1 )); echo "$k" > "$D/notifs"
          note "PROBE measure live minute=$k arrivals=100 sincePrevLineSec=60 sinceLastArrivalSec=0 screen=on"
          [ -n "${FAKE_AWAY_AFTER:-}" ] && [ "$k" -eq "$FAKE_AWAY_AFTER" ] && touch "$D/away"
          exit 0
        fi
        exit 0;;
      am)
        if [ "$1" = start ] && echo "$*" | grep -q ProbeFrontActivity; then
          if fails nostart; then echo "Error: Activity class {com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity} does not exist." >&2; exit 1; fi
          keep=false; echo "$*" | grep -q -- '--ez keep true' && keep=true
          note "PROBE front resumed screen=on inFront=false keepOn=$keep"
          note "PROBE front focus screen=on inFront=true keepOn=$keep"
          echo "Starting: Intent { cmp=com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity }"
          exit 0
        fi
        if [ "$1" = start ]; then
          note "PROBE measure start registered"
          fails unavail && note "PROBE measure availability UNAVAILABLE"
          fails noavail || fails unavail || note "PROBE measure availability AVAILABLE"
          exit 0
        fi
        cmdname=""; prev=""
        for a in "$@"; do [ "$prev" = cmd ] && cmdname="$a"; prev="$a"; done
        case "$cmdname" in
          measure-stop) note "PROBE measure stopped";;
          measure-clear) note "PROBE measure cleared";;
          vibrate) note "PROBE vibrate amplitudeControl=true";;
          notify-alarm) note "PROBE notify-alarm posted channel=probe_alarm";;
          alarm-clock) note "PROBE alarm-clock scheduled in 15 s"; note "PROBE alarm-clock fired"; note "PROBE alert screen shown";;
          measure-capabilities) note "PROBE measure capabilities heartRateMeasure=true";;
          measure-report)
            if fails stalled; then r=$(cat "$D/readings"); [ "$r" -gt 0 ] || r=100; else r=$(( $(cat "$D/readings") + 100 )); fi
            echo "$r" > "$D/readings"
            note "PROBE measure screen=all readings=$r perMin=10.0 gapSec median=1 p95=1 max=2"
            note "PROBE measure battery start=68 now=67 dropPerHour=1.0";;
        esac
        echo "Broadcast completed: result=0"; exit 0;;
    esac;;
esac
exit 0
