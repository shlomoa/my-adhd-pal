#!/usr/bin/env bash
# Simulated adb for scripts/probe/test-run-e1.sh: one Galaxy Watch at 192.168.1.16:41613 with the debug probe installed.
# State lives in $FAKE_DIR: calls (every invocation), log (the PROBE logcat), timeout, battery, offline.
# Failure injection (FAKE_FAIL, comma separated):  noavail  the service never reports AVAILABLE
#                                                  unavail  the service reports only UNAVAILABLE
#                                                  noaod    no always-on-display setting key is present
#                                                  nosleep  the sleep key does not turn the screen off
#                                                  nostart  the front screen cannot be started
#                                                  nonotif  the notification is never listed
#                                                  svcgone  the measure service is not listed as running
#                                                  stalled  the report's reading count never grows
#                                                  nodebug  the debug probe build is not installed (no Probe components in dumpsys package)
#                                                  flaky    every 3rd `shell echo` fails (an unstable connection)
#                                                  dead     every command fails (the watch cannot be reached)
#                                                  hang     `dumpsys notification` never returns (a hung adb)
#                                                  novibrator  the vibrator service lists no new vibration after `vibrate`
#                                                  hangdemo  `am start` of the Monitoring screen never returns
#                                                  noexercise  an `am start` of the probe in an exercise mode logs `exercise start failed` and registers nothing
#                                                  reportfail  the measure-report command fails and logs nothing
# FAKE_AWAY_AFTER=N (+ FAKE_AWAY_CALLS=K): after the Nth report the watch goes away (Wi-Fi off): every adb call fails, and the first K
#   `adb connect` calls fail too; the next one brings it back.
# FAKE_FAIL=portchange (with FAKE_AWAY_AFTER=N): after the Nth report the watch comes back on port 42000: the old address never answers
#   again, `adb mdns services` lists the new port (not with nomdns), `adb connect 192.168.1.16:42000` works, and from then on every
#   command needs ANDROID_SERIAL=192.168.1.16:42000 (or -s with it). `adb devices` lists the connected address.
# FAKE_MDNSNAME=1: `adb devices` also lists the mDNS name adb-FAKE1234-abc._adb-tls-connect._tcp (it never changes with the port), `-s <name>` works
#   in every state (also after a port change), `adb connect <name>` fails like the real adb, `getprop ro.serialno` answers FAKE1234.
# FAKE_BATTERY=N: the starting battery level (default 68).
# FAKE_PHONE (default PHONE123): the serial of a simulated phone; `-s PHONE123` commands use their own log ($D/plog): grants, appops, install,
#   and `am broadcast ... DUMP_ALERTS`, which prints the DEMO alert lines of the last alert the watch sent (not with FAKE_FAIL=nophonealert).
# Watch stress demo (MonitoringActivity, MonitorDemoReceiver --es cmd baseline|series|inject|im-ok|status): notes the DEMO monitor lines; FAKE_FAIL=noevent
#   makes `series` raise no event.
# FAKE_DROP=1: after `input keyevent KEYCODE_SLEEP` the connection drops (device offline) until `adb connect`.
# FAKE_CHARGING=1: the watch is on its charger. It simulates the commands; it proves nothing about the watch.
set -u
D="${FAKE_DIR:?FAKE_DIR must point at the simulation state folder}"
fails() { case ",${FAKE_FAIL:-}," in *",$1,"*) return 0;; esac; return 1; }
echo "$*" >> "$D/calls"
touch "$D/log"
[ -e "$D/timeout" ] || echo 30000 > "$D/timeout"
[ -e "$D/battery" ] || echo "${FAKE_BATTERY:-68}" > "$D/battery"
[ -e "$D/readings" ] || echo 0 > "$D/readings"
serial="${ANDROID_SERIAL:-}"
[ "${1:-}" = "-s" ] && { serial="$2"; shift 2; }
cmd="${1:-}"; shift || true
if [ "$serial" = "${FAKE_PHONE:-PHONE123}" ]; then
  case "$cmd" in
    logcat)
      for a in "$@"; do case "$a" in -c) : > "$D/plog"; exit 0;; -d) cat "$D/plog" 2>/dev/null; exit 0;; esac; done; exit 0;;
    install) echo "Success"; exit 0;;
    shell)
      sub="${1:-}"; shift || true
      case "$sub" in
        echo) echo "$@"; exit 0;;
        getprop) echo PHONEFAKE1; exit 0;;
        date) date +%s; exit 0;;
        appops) if [ "${1:-}" = get ]; then echo "USE_FULL_SCREEN_INTENT: allow"; fi; exit 0;;
        dumpsys) echo "      android.permission.POST_NOTIFICATIONS: granted=true"; exit 0;;
        am)
          if echo "$*" | grep -q DUMP_ALERTS; then
            at="$(cat "$D/lastalert" 2>/dev/null || true)"
            if [ -n "$at" ] && ! fails nophonealert; then
              echo "DEMO alert stored id=PA1 watchAt=$at storedAt=$((at + 400))" >> "$D/plog"
              echo "DEMO alert raised id=PA1 raisedAt=$((at + 900)) sound=1" >> "$D/plog"
              echo "DEMO alerts end count=1" >> "$D/plog"
            else
              echo "DEMO alerts end count=0" >> "$D/plog"
            fi
            echo "Broadcast completed: result=0"
          fi
          exit 0;;
      esac
      exit 0;;
  esac
  exit 0
fi
if fails dead; then echo "error: device offline" >&2; exit 1; fi
if [ -e "$D/away" ] && fails portchange; then
  case "$cmd" in
    mdns)
      fails nomdns || { echo "List of discovered mdns services"; echo "adb-FAKE-1	_adb-tls-connect._tcp	192.168.1.16:42000"; echo "adb-FAKE-1	_adb-tls-pairing._tcp	192.168.1.16:39999"; }
      exit 0;;
    devices) echo "List of devices attached"; [ -n "${FAKE_MDNSNAME:-}" ] && echo "adb-FAKE1234-abc._adb-tls-connect._tcp	device"; exit 0;;
    connect)
      case "${1:-}" in adb-*) echo "failed to resolve host: ${1:-}" >&2; exit 1;; esac
      if [ "${1:-}" = "192.168.1.16:42000" ]; then rm -f "$D/away"; touch "$D/moved"; echo "connected to 192.168.1.16:42000"; exit 0; fi
      echo "failed to connect to $1" >&2; exit 1;;
    *)
      if [ -n "${FAKE_MDNSNAME:-}" ] && [ "$serial" = "adb-FAKE1234-abc._adb-tls-connect._tcp" ]; then rm -f "$D/away"; touch "$D/moved"; else echo "error: no devices/emulators found" >&2; exit 1; fi;;
  esac
fi
if [ -e "$D/moved" ]; then
  case "$cmd" in
    connect) if [ "${1:-}" = "192.168.1.16:42000" ]; then echo "connected to 192.168.1.16:42000"; exit 0; fi; echo "failed to connect to $1" >&2; exit 1;;
    devices) echo "List of devices attached"; echo "192.168.1.16:42000	device"; [ -n "${FAKE_MDNSNAME:-}" ] && echo "adb-FAKE1234-abc._adb-tls-connect._tcp	device"; exit 0;;
    mdns) echo "List of discovered mdns services"; exit 0;;
    *) [ "$serial" = "192.168.1.16:42000" ] || { [ -n "${FAKE_MDNSNAME:-}" ] && [ "$serial" = "adb-FAKE1234-abc._adb-tls-connect._tcp" ]; } || { echo "$cmd" >> "$D/rejected"; echo "error: device '$serial' not found" >&2; exit 1; };;
  esac
fi
if [ "$cmd" = mdns ]; then echo "List of discovered mdns services"; exit 0; fi
if [ "$cmd" = devices ]; then echo "List of devices attached"; echo "192.168.1.16:41613	device"; [ -n "${FAKE_MDNSNAME:-}" ] && echo "adb-FAKE1234-abc._adb-tls-connect._tcp	device"; exit 0; fi
if [ "$cmd" = connect ]; then case "${1:-}" in adb-*) echo "failed to resolve host: ${1:-}" >&2; exit 1;; esac; fi
if [ -e "$D/away" ]; then
  if [ "$cmd" = connect ]; then
    n=$(( $(cat "$D/awayconnects" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$D/awayconnects"
    if [ "$n" -le "${FAKE_AWAY_CALLS:-3}" ]; then echo "failed to connect to 192.168.1.16:41613" >&2; exit 1; fi
    rm -f "$D/away" "$D/awayconnects"
  else
    echo "error: no devices/emulators found" >&2; exit 1
  fi
fi
if [ "$cmd" = connect ]; then rm -f "$D/offline"; echo "connected to 192.168.1.16:41613"; exit 0; fi
if [ -e "$D/offline" ]; then echo "error: device offline" >&2; exit 1; fi
note() { echo "$1" >> "$D/log"; }
case "$cmd" in
  install) echo "Success"; exit 0;;
  logcat)
    for a in "$@"; do
      case "$a" in
        -G) echo "${2:-4M}" > "$D/logbuf"; exit 0;;
        -g) if [ -e "$D/logbuf" ]; then echo "main: ring buffer is 4 MiB (3 MiB consumed), max entry size 5120 B"; else echo "main: ring buffer is 256 KiB (3 KiB consumed), max entry size 5120 B"; fi; exit 0;;
        -c) : > "$D/log"; exit 0;;
        -d) cat "$D/log"; exit 0;;
      esac
    done
    exit 0;;
  shell)
    sub="${1:-}"; shift || true
    case "$sub" in
      date) date +%s; exit 0;;
      echo)
        if fails flaky; then n=$(( $(cat "$D/echoes" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$D/echoes"; [ $((n % 3)) -eq 0 ] && { echo "error: closed" >&2; exit 1; }; fi
        echo "$@"; exit 0;;
      getprop) [ "${1:-}" = ro.serialno ] && echo FAKE1234; exit 0;;
      settings)
        if [ "$1" = get ]; then
          if [ "$3" = screen_off_timeout ]; then cat "$D/timeout"
          elif [ "$2/$3" = secure/doze_always_on ] && ! fails noaod && [ ! -e "$D/set-secure-doze_always_on" ]; then echo 1
          elif [ -e "$D/set-$2-$3" ]; then cat "$D/set-$2-$3"
          else echo null; fi
        elif [ "$3" = screen_off_timeout ]; then echo "$4" > "$D/timeout"
        else echo "$4" > "$D/set-$2-$3"; fi
        exit 0;;
      pm)
        if [ "$1" = revoke ]; then echo "java.lang.SecurityException: Permission $3 is not granted" >&2; exit 255; fi
        exit 0;;
      cmd)
        if [ "$1" = notification ]; then echo "$2 $3" >> "$D/dnd"; fi
        exit 0;;
      input)
        [ "$2" = KEYCODE_SLEEP ] && [ -n "${FAKE_DROP:-}" ] && touch "$D/offline"
        if [ "$2" = KEYCODE_SLEEP ] && ! fails nosleep; then echo OFF > "$D/screen"; fi
        if [ "$2" = KEYCODE_WAKEUP ]; then echo ON > "$D/screen"; fi
        exit 0;;
      dumpsys)
        if [ "$1" = battery ]; then
          n="$(cat "$D/battery")"
          if [ -n "${FAKE_CHARGING:-}" ]; then echo "  AC powered: true"; else echo "  AC powered: false"; fi
          echo "  level: $n"; echo $((n - 1)) > "$D/battery"; exit 0
        fi
        if [ "$1" = vibrator_manager ]; then
          echo "VibratorManagerService:"; echo "  Recent vibrations:"; cat "$D/vibrations" 2>/dev/null; exit 0
        fi
        if [ "$1" = window ]; then
          if [ -e "$D/alertshown" ]; then echo "  mCurrentFocus=Window{1 u0 com.shlomoa.myadhdpal/com.shlomoa.myadhdpal.wear.debug.probe.ProbeAlertActivity}"
          else echo "  mCurrentFocus=Window{1 u0 com.sec.android.app.launcher/com.sec.android.app.launcher.Home}"; fi
          exit 0
        fi
        if [ "$1" = power ]; then
          echo "  mWakefulness=Awake"; echo "Display Power: state=$(cat "$D/screen" 2>/dev/null || echo ON)"; exit 0
        fi
        if [ "$1" = activity ] && [ "${2:-}" = activities ]; then
          echo "  mResumedActivity: ActivityRecord{1 u0 com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity t5}"
          exit 0
        fi
        if [ "$1" = activity ]; then
          fails svcgone || echo "  * ServiceRecord{1 u0 com.shlomoa.myadhdpal/.wear.debug.probe.ProbeMeasureService}"
          exit 0
        fi
        if [ "$1" = package ]; then
          fails nodebug || echo "      com.shlomoa.myadhdpal/.wear.debug.probe.ProbeReceiver com.shlomoa.myadhdpal/.wear.debug.probe.ProbeMeasureService com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity"
          echo "      android.permission.health.READ_HEART_RATE: granted=true"
          echo "      android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND: granted=false"
          exit 0
        fi
        if [ "$1" = notification ]; then
          fails hang && exec sleep 600
          fails nonotif || echo "      android.title=Probe: measuring heart rate"
          k=$(( $(cat "$D/notifs" 2>/dev/null || echo 0) + 1 )); echo "$k" > "$D/notifs"
          note "PROBE measure live minute=$k arrivals=100 sincePrevLineSec=60 sinceLastArrivalSec=0 screen=on"
          [ -n "${FAKE_AWAY_AFTER:-}" ] && [ "$k" -eq "$FAKE_AWAY_AFTER" ] && touch "$D/away"
          exit 0
        fi
        exit 0;;
      am)
        if [ "$1" = start ] && echo "$*" | grep -q ProbeFrontActivity; then
          if fails nostart; then echo "Error: Activity class {com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity} does not exist." >&2; exit 1; fi
          keep=false; echo "$*" | grep -q -- '--ez keep true' && keep=true
          note "PROBE front resumed screen=on inFront=false keepOn=$keep"
          note "PROBE front focus screen=on inFront=true keepOn=$keep"
          echo "Starting: Intent { cmp=com.shlomoa.myadhdpal/.wear.debug.probe.ProbeFrontActivity }"
          exit 0
        fi
        if [ "$1" = start ] && echo "$*" | grep -q MonitoringActivity; then
          fails hangdemo && exec sleep 600
          note "DEMO monitor started registered=true"; touch "$D/monitoring"
          echo "Starting: Intent { cmp=com.shlomoa.myadhdpal/.wear.monitor.MonitoringActivity }"; exit 0
        fi
        if [ "$1" = start ]; then
          mode=measure; prev=""
          for a in "$@"; do [ "$prev" = mode ] && mode="$a"; prev="$a"; done
          echo "$mode" > "$D/mode"
          note "PROBE measure mode=$mode"
          if fails noexercise && [ "${mode#exercise}" != "$mode" ]; then note "PROBE measure exercise start failed: refused"; exit 0; fi
          note "PROBE measure start registered"
          fails unavail && note "PROBE measure availability UNAVAILABLE"
          fails noavail || fails unavail || note "PROBE measure availability AVAILABLE"
          exit 0
        fi
        cmdname=""; prev=""
        for a in "$@"; do [ "$prev" = cmd ] && cmdname="$a"; prev="$a"; done
        case "$cmdname" in
          baseline) note "DEMO inject baseline fed hours=25"; note "DEMO monitor first reading at=$(date +%s)000"; touch "$D/baselined";;
          series)
            if ! fails noevent; then
              ms="$(date +%s)000"
              note "DEMO monitor event level=1 episode=00000000-0000-4000-8000-000000000001 at=$ms"
              note "DEMO monitor response level=1 at=$ms"
              note "DEMO monitor alert sent level=1 at=$ms"
              echo "$ms" > "$D/lastalert"
            fi;;
          im-ok) [ -e "$D/lastalert" ] && note "DEMO monitor episode ended id=00000000-0000-4000-8000-000000000001";;
          status) b=false; [ -e "$D/baselined" ] && b=true; note "DEMO monitor status stress=false level=0 readings=21 baselineKnown=$b";;
          measure-stop) note "PROBE measure stopped";;
          measure-clear) note "PROBE measure cleared";;
          vibrate) note "PROBE vibrate amplitudeControl=true"; fails novibrator || echo "    2026-10-18 12:00:$(( $(wc -l < "$D/vibrations" 2>/dev/null || echo 0) + 10 )) | Vibration{id=$RANDOM usage=ALARM amplitude=255 status=FINISHED}" >> "$D/vibrations";;
          notify-alarm) note "PROBE notify-alarm posted channel=probe_alarm";;
          alarm-clock) note "PROBE alarm-clock scheduled in 15 s"; note "PROBE alarm-clock fired"; note "PROBE alert screen shown"; touch "$D/alertshown"; fails novibrator || echo "    2026-10-18 12:01:$(( $(wc -l < "$D/vibrations" 2>/dev/null || echo 0) + 10 )) | Vibration{id=$RANDOM usage=ALARM amplitude=255 status=FINISHED}" >> "$D/vibrations";;
          m2-capabilities) note "PROBE m2 capabilities reportingOverrides=[HEART_RATE_5_SECONDS]"; note "PROBE m2 capabilities passiveGoalHeartRate=false";;
          measure-capabilities) note "PROBE measure capabilities heartRateMeasure=true";;
          measure-report)
            if fails reportfail; then echo "error: broadcast failed" >&2; exit 1; fi
            if fails stalled; then r=$(cat "$D/readings"); [ "$r" -gt 0 ] || r=100; else r=$(( $(cat "$D/readings") + 100 )); fi
            echo "$r" > "$D/readings"
            note "PROBE measure screen=all readings=$r perMin=10.0 gapSec median=1 p95=1 max=2"
            if [ "$(cat "$D/screen" 2>/dev/null)" = OFF ]; then note "PROBE measure samples screen=off readings=$r sampleGapSec max=1 delaySec median=2.0 p95=4.0 max=8.0"; fi
            note "PROBE measure battery start=68 now=67 dropPerHour=1.0";;
        esac
        echo "Broadcast completed: result=0"; exit 0;;
    esac;;
esac
exit 0
