<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Hardware spike apps (docs/spikes/README.md): a second launcher entry, a command receiver driven by
             adb broadcasts (protected by DUMP, which only `adb shell` holds) and a listener service that logs Data Layer events. Debug builds only. -->
        <activity
            android:name=".debug.spike.SpikeActivity"
            android:exported="true"
            android:label="Spike">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".debug.spike.SpikeCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Real-device demo (scripts/demo): adb broadcasts, protected by DUMP like the spike receiver. Debug builds only. -->
        <receiver
            android:name=".debug.DemoScheduleReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.shlomoa.myadhdpal.debug.PUBLISH_DEMO_SCHEDULE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.DemoHistoryReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.shlomoa.myadhdpal.debug.DUMP_HISTORY" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.DemoAlertsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.shlomoa.myadhdpal.debug.DUMP_ALERTS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.DemoSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.shlomoa.myadhdpal.debug.SEED_FIXTURES" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".debug.DemoDismissReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.shlomoa.myadhdpal.debug.DISMISS_ALERT" />
            </intent-filter>
        </receiver>

        <service
            android:name=".debug.spike.SpikeListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/spike" />
            </intent-filter>
        </service>
    </application>
</manifest>
